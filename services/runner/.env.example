# Copy to services/runner/.env only when configuring a new runtime; never overwrite a working file.
# Server-only credentials. Never commit the populated file or use NEXT_PUBLIC_ prefixes.
# Docker supplies tool paths and Ollama defaults; Windows runtime variables are documented in
# docs/public-beta-deployment.md under Self-hosted worker.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
