# Web/developer-fixture example. Use an operator-controlled absolute analyzer path.
# Queued jobs use services/runner/.env instead. Do not overwrite working configuration.
WHITEHAT_ANALYZER_ROOT=C:/path/to/whitehat/services/analyzer

# Server-only Supabase values. Put in apps/web/.env.local; never NEXT_PUBLIC.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY

# Ollama is the current self-hosted AI provider. Loopback is private to the worker runtime.
# These settings do not make the public web application localhost-only.
WHITEHAT_AI_PROVIDER=ollama
WHITEHAT_AI_BASE_URL=http://localhost:11434
WHITEHAT_AI_MODEL=qwen2.5-coder:7b

# Server-only production registry. Leave blank until deployed and verified on chain 4663.
# No fallback to the testnet registry. Verified production token details are recorded in docs/deployments/robinhood-mainnet.json.
WHITEHAT_MAINNET_REGISTRY_ADDRESS=
WHITEHAT_MAINNET_REGISTRY_DEPLOYMENT_BLOCK=

# Fill only with actual verified testnet deployment values; leave blank before deployment.
WHITEHAT_TESTNET_TOKEN_ADDRESS=
WHITEHAT_TESTNET_REGISTRY_ADDRESS=
WHITEHAT_TESTNET_REGISTRY_DEPLOYMENT_BLOCK=

# Public beta: exact HTTPS origin and approved operator wallets
WHITEHAT_PUBLIC_ORIGIN=
WHITEHAT_ADMIN_WALLETS=
