# Save locally as contracts/.env (gitignored). Dedicated testnet wallet only.
WHITEHAT_TESTNET_PRIVATE_KEY=
# Optional: defaults to the dedicated deployment wallet. Not a public distribution.
WHITEHAT_TESTNET_TOKEN_RECIPIENT=

# Public addresses for the separate mainnet script (4663).
# Signer(s) must be supplied explicitly; the script never uses the testnet key.
WHITEHAT_MAINNET_DEPLOYER=
WHITEHAT_MAINNET_ADMIN=
